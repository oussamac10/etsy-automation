# =============================================================================
# Etsy PNG Automation — example environment
# Copy to .env and edit.  NEVER commit a real .env or a real credential.
# Phase 1 runs end-to-end with these placeholder values and FAKE providers.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
APP_ENV=local                       # local | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# --- Security --------------------------------------------------------------
# Generate locally with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Placeholder only. Startup validation rejects these defaults when APP_ENV != local.
SECRET_KEY=dev-only-insecure-secret-key-change-me
# Versioned application encryption key. Encrypts provider credentials (and, from
# Phase 5, Etsy OAuth tokens) at rest. Any string of at least 32 characters; a
# Fernet key is derived from it with HKDF-SHA256.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=dev-only-insecure-encryption-key-change-me
# Bump whenever ENCRYPTION_KEY changes; ciphertext written under a version the
# process does not hold a key for is rejected, not silently retried.
ENCRYPTION_KEY_VERSION=1
# Set both only while rotating, so rows written under the retired key stay
# readable, then run `python -m app.rotate_encryption_key` and unset them again.
# ENCRYPTION_KEY_PREVIOUS=
# ENCRYPTION_KEY_PREVIOUS_VERSION=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Session cookie (ADR-0002) ---------------------------------------------
SESSION_COOKIE_NAME=etsy_session
SESSION_TTL_HOURS=12                # 1..720
# Must be true outside APP_ENV=local; startup validation enforces it.
SESSION_COOKIE_SECURE=false

# --- Owner bootstrap -------------------------------------------------------
# Used only by `python -m app.fixtures.bootstrap_owner`. Never commit a real
# password here; export it in the shell that runs the command.
# BOOTSTRAP_OWNER_EMAIL=owner@example.com
# BOOTSTRAP_OWNER_NAME=Shop owner
# BOOTSTRAP_OWNER_PASSWORD=

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=etsy
POSTGRES_PASSWORD=etsy_local_password
POSTGRES_DB=etsy_automation
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://etsy:etsy_local_password@localhost:5432/etsy_automation

# --- Redis / queue ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
QUEUE_BROKER=dramatiq                # ADR-0001: Dramatiq on Redis
QUEUE_NAMESPACE=etsy_automation

# --- Object storage (MinIO locally, any S3-compatible service elsewhere) ----
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=etsy-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Image worker (Node/Sharp) ---------------------------------------------
IMAGE_WORKER_HOST=0.0.0.0
IMAGE_WORKER_PORT=8100
IMAGE_WORKER_URL=http://localhost:8100
IMAGE_MAX_INPUT_BYTES=41943040       # 40 MiB
IMAGE_MAX_PIXELS=50000000            # 50 MP decompression guard

# --- Web (Nuxt) ------------------------------------------------------------
NUXT_PUBLIC_API_BASE=http://localhost:8000

# --- Providers -------------------------------------------------------------
# Keep PROVIDER_MODE=fake for development/tests.
# Use live only for deliberate real-provider smoke tests.
PROVIDER_MODE=fake                   # fake | live

# OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=gpt-5.6-luna
# OPENAI_IMAGE_MODEL=gpt-image-2

RECRAFT_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=http://localhost:3000/api/etsy/callback
ETSY_SHOP_ID=

USPTO_TSDR_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Cost controls ---------------------------------------------------------
DEFAULT_RUN_BUDGET_USD=1.00
MONTHLY_BUDGET_USD=30.00
PAID_SMOKE_TEST_ENABLED=false        # must stay false in CI and normal test runs
