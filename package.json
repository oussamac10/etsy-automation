{
  "name": "etsy-png-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Research-to-Etsy-draft automation for original PNG products. Never publishes automatically.",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "playwright test",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "dev:web": "pnpm --filter @etsy/web dev",
    "dev:image-worker": "pnpm --filter @etsy/image-worker dev",
    "doc:schema": "./.venv/bin/python backend/scripts/generate_schema_docs.py || python backend/scripts/generate_schema_docs.py",
    "doc:schema:check": "./.venv/bin/python backend/scripts/generate_schema_docs.py --check || python backend/scripts/generate_schema_docs.py --check",
    "compose:config": "docker compose config --quiet",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "nanoid": ">=3.3.18",
    "ioredis": ">=5.11.1"
  }
}
